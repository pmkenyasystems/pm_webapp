// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin") // super_admin, admin
  modules   String? // JSON array of modules: ["news", "events", "elections", "positions", "members", "volunteers", "donations"]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles Article[] @relation("ArticleAuthor")
}

model Member {
  id                   Int       @id @default(autoincrement())
  idNumber             String    @unique
  ippmsId              String?   @unique
  surname              String
  otherNames           String
  email                String?
  phone                String?
  dateOfBirth          DateTime?
  gender               String?
  religion             String?
  ethnicity            String?
  address              String?
  countyCode           Int?
  constituencyCode     Int?
  wardCode             Int?
  youth                Boolean?  @default(false) // Youth (yes/no)
  pwd                  Boolean?  @default(false) // PWD (yes/no)
  membershipDate       DateTime  @default(now())
  status               String    @default("active") // active, inactive, suspended
  password             String? // Hashed password for member login
  membershipCategoryId String? // Reference to membership category
  profileCreatedAt     DateTime  @default(now())
  ippmsDataSyncedAt    DateTime? // Date/time when IPPMS data was last synced/updated
  updatedAt            DateTime  @updatedAt

  membershipCategory MembershipCategory?      @relation(fields: [membershipCategoryId], references: [id])
  volunteers         Volunteer[]
  subscriptions      MembershipSubscription[]
  countyOfficials    CountyOfficial[]
  county             County?       @relation(fields: [countyCode], references: [countyCode], onDelete: SetNull)
  constituency       Constituency? @relation(fields: [constituencyCode], references: [constituencyCode], onDelete: SetNull)
  ward               Ward?         @relation(fields: [wardCode], references: [wardCode], onDelete: SetNull)

  @@index([countyCode])
  @@map("member")
}

model MembershipCategory {
  id        String   @id @default(cuid())
  title     String   @unique
  fee       Float
  timeline  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members Member[]

  @@map("membership_category")
}

model MembershipSubscription {
  id            String   @id @default(cuid())
  idNumber      String // ID_Number of the member
  amount        Float
  currency      String   @default("KES")
  paymentMethod String // mpesa, card, paypal
  transactionId String? // Transaction ID from payment provider
  status        String   @default("pending") // pending, completed, failed
  periodStart   DateTime // Start date of the 5-year subscription period
  periodEnd     DateTime // End date of the 5-year subscription period (5 years from start)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  member Member @relation(fields: [idNumber], references: [idNumber])

  @@index([idNumber])
}

model Volunteer {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  phone        String
  idNumber     String?
  address      String?
  county       String?
  skills       String? // JSON string of skills
  availability String? // full-time, part-time, weekends, etc.
  motivation   String? // Why they want to volunteer
  isMember     Boolean  @default(false)
  memberId     Int?
  status       String   @default("pending") // pending, approved, rejected
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  member Member? @relation(fields: [memberId], references: [id])
}

model Donation {
  id            String   @id @default(cuid())
  amount        Float
  currency      String   @default("KES")
  paymentMethod String // mpesa, card
  transactionId String? // M-Pesa transaction ID or Stripe payment intent ID
  donorName     String?
  donorEmail    String?
  donorPhone    String?
  status        String   @default("pending") // pending, completed, failed
  metadata      String? // JSON string for additional data
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MaterialDonation {
  id          String   @id @default(cuid())
  donorName   String
  donorEmail  String?
  donorPhone  String?
  description String  // Item or description of donation
  quantity    String? // e.g. "10 bags", "5 boxes"
  status      String   @default("pending") // pending, received
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String // Rich text content
  excerpt     String?
  imageUrl    String?
  authorId    String
  published   Boolean   @default(false)
  publishedAt DateTime?
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author User @relation("ArticleAuthor", fields: [authorId], references: [id])
}

model County {
  id         String   @id @default(cuid())
  countyCode Int      @unique
  countyName String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  constituencies Constituency[]
  aspirants      Aspirant[]
  countyOfficials CountyOfficial[]
  members        Member[]
}

model CountyOfficial {
  id         String   @id @default(cuid())
  countyCode Int
  role       String   // Chairperson, Secretary, Treasurer, Youth Representative, Women Representative, PWD Representative
  memberId   Int?
  name       String?  // display name when not linked to member
  email      String?
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  county County @relation(fields: [countyCode], references: [countyCode], onDelete: Cascade)
  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([countyCode, role])
}

model Constituency {
  id               String   @id @default(cuid())
  constituencyCode Int      @unique
  constituencyName String
  countyCode       Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  county    County     @relation(fields: [countyCode], references: [countyCode])
  wards     Ward[]
  aspirants Aspirant[]
  members   Member[]

  @@unique([constituencyCode, countyCode])
}

model Ward {
  id               String   @id @default(cuid())
  wardCode         Int      @unique
  wardName         String
  constituencyCode Int
  registeredVoters Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  constituency Constituency @relation(fields: [constituencyCode], references: [constituencyCode])
  aspirants    Aspirant[]
  members      Member[]

  @@unique([wardCode, constituencyCode])
}

model Position {
  id            Int      @id @default(autoincrement())
  positionTitle String   @map("position_title")
  positionLevel String   @map("position_level") // e.g., "National", "County", "Constituency", "Ward"
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  aspirants Aspirant[]

  @@map("position")
}

model Election {
  id           String   @id @default(cuid())
  title        String
  description  String?
  electionDate DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  aspirants Aspirant[]
}

model Aspirant {
  id               String   @id @default(cuid())
  idNumber         String   @map("id_number") // ID_Number of the logged-in member
  fullName         String?  @map("full_name")
  phone            String?
  email            String?
  electionId       String   @map("election_id")
  positionId       Int      @map("position_id")
  country          String   @default("Kenya")
  countyCode       Int?     @map("county_code")
  constituencyCode Int?     @map("constituency_code")
  wardCode         Int?     @map("ward_code")
  pollingStation   String?  @map("polling_station")
  status           Int      @default(0) // 0 = pending, 1 = approved, 2 = rejected
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  election     Election      @relation(fields: [electionId], references: [id], onDelete: Cascade)
  position     Position      @relation(fields: [positionId], references: [id])
  county       County?       @relation(fields: [countyCode], references: [countyCode])
  constituency Constituency? @relation(fields: [constituencyCode], references: [constituencyCode])
  ward         Ward?         @relation(fields: [wardCode], references: [wardCode])

  @@unique([idNumber, electionId, positionId])
  @@map("aspirant")
}
